{
    "name": "overtrue/laravel-payment",
    "description": "Omnipay ServiceProvider for Laravel.",
    "type": "library",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.30",
        "php-http/guzzle7-adapter": "^1.1",
        "league/omnipay": "^3.2.1",
        "omnipay/common": "^3.5.1"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.5.8"
    },
    "autoload": {
        "psr-4": {
            "Overtrue\\LaravelPayment\\": "./src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Overtrue\\LaravelPayment\\Tests\\": "./tests",
            "Omnipay\\": "./tests/Omnipay"
        }
    },
    "license": "MIT",
    "authors": [
        {
            "name": "overtrue",
            "email": "anzhengchao@gmail.com"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Overtrue\\LaravelPayment\\ServiceProvider"
            ],
            "aliases": {
                "LaravelPayment": "Overtrue\\LaravelPayment\\Facade"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find src tests config -name \"*.php\" -print0 | xargs -0 -n1 php -l"
    },
    "config": {
        "policy": {
            "abandoned": {
                "block": true
            }
        }
    }
}
