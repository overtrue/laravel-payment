<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.5/phpunit.xsd"
         bootstrap="vendor/autoload.php" colors="true" cacheDirectory=".phpunit.cache"
         failOnWarning="true" failOnRisky="true" failOnDeprecation="true">
    <testsuites><testsuite name="Laravel Payment"><directory>tests</directory></testsuite></testsuites>
    <source><include><directory>src</directory></include></source>
</phpunit>
